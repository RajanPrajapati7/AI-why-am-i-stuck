# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Client & CORS
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/why_am_i_stuck_db

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_string_at_least_16_chars
JWT_EXPIRES_IN=7d
COOKIE_SAME_SITE=lax

# Google Gemini AI (Optional - falls back to built-in Cognitive Heuristic Engine if omitted)
GEMINI_API_KEY=replace_with_your_google_gemini_api_key
